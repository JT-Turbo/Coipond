    </Reference>
    <Reference Include="Unity.VectorGraphics">
      <HintPath>$(COI_ROOT)\Captain of Industry_Data\Managed\Unity.VectorGraphics.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command=":: copy the freshly-built DLL&#xA;xcopy /Y /I &quot;$(TargetPath)&quot; &quot;%25APPDATA%25\Captain of Industry\Mods\Coipond\&quot;&#xA;&#xA;:: (optional) copy the PDB for easier stack-traces&#xA;xcopy /Y /I &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;%25APPDATA%25\Captain of Industry\Mods\Coipond\&quot;&#xA;" />
  </Target>
